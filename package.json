{
  "name": "sveltekit-omakase",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "postinstall": "npx simple-git-hooks",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "fix": "prettier --write . && eslint . --fix",
    "test:e2e": "playwright install chromium && playwright test",
    "test:unit": "vitest",
    "test": "vitest --run && pnpm test:e2e",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:drop": "drizzle-kit drop",
    "db:clear": "vite-node --options.transformMode.ssr='/.*/' src/lib/db/clear",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.76.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-auto": "^9.0.0",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "bits-ui": "2.21.0",
    "cn": "^0.5.2",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "lint-staged": "^17.6.1",
    "mode-watcher": "^1.1.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn-svelte": "^1.8.1",
    "simple-git-hooks": "^2.14.0",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.3",
    "sveltekit-flash-message": "^3.0.0",
    "sveltekit-rate-limiter": "^0.8.0",
    "tailwind-variants": "^4.0.2",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "valibot": "^1.5.0",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/s3-request-presigner": "^3.1172.0",
    "@better-auth/utils": "0.5.1",
    "@better-svelte-email/components": "^2.4.0",
    "@better-svelte-email/server": "^2.4.0",
    "@libsql/client": "^0.18.0",
    "better-auth": "^1.7.26",
    "drizzle-orm": "^0.45.4",
    "qrcode": "^1.5.4",
    "resend": "^6.39.0",
    "uuid": "^14.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,svelte,json,css,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#config": "./src/lib/config/config.ts",
    "#config/server": "./src/lib/config/config.server.ts",
    "#messages": "./src/lib/config/messages/index.ts",
    "#components/*": "./src/lib/components/*",
    "#models": "./src/lib/db/models/index.ts",
    "#models/*": "./src/lib/db/models/*",
    "#queries": "./src/lib/db/queries/index.ts",
    "#queries/*": "./src/lib/db/queries/*",
    "#remote": "./src/lib/remote/index.ts",
    "#remote/*": "./src/lib/remote/*"
  }
}
